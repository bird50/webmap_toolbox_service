PORT=4010
HOST=127.0.0.1
SQLITE_PATH=./data/toolbox.sqlite
TOOLBOX_SERVICE_KEY=replace-with-at-least-32-random-characters
# App that the key above and rows published before 1.1 belong to. Set before the first start of 1.1; it is stamped once.
TOOLBOX_DEFAULT_APP_ID=default
# Tool modules this instance serves: comma list of photos, drawings, data-files (default: all). Disabled modules answer 404 and create no tables.
TOOLBOX_MODULES=photos,drawings,data-files
