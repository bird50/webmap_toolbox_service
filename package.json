{
  "name": "thaiwater-toolbox-service",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "key:create": "node --env-file-if-exists=.env --import tsx src/keys.ts create",
    "key:list": "node --env-file-if-exists=.env --import tsx src/keys.ts list",
    "key:revoke": "node --env-file-if-exists=.env --import tsx src/keys.ts revoke"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
